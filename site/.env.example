# Where the agent registry answers health checks.
# Unset in a preview build: with no registry the listing reports "No registry"
# rather than presenting an agent as available on no evidence.
VITE_REGISTRY_URL=

# Optional. Where the hero access form posts. With this unset the form hands
# off to the visitor own mail client instead of reporting a success that
# nothing performed.
VITE_WAITLIST_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Payments (server side only — these are NOT VITE_ prefixed on purpose, so they
# are never bundled into the browser build).
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Holds developers, their agents, and one receipt per paid call.
DATABASE_URL=

# Where the marketplace's cut is paid. REQUIRED — there is deliberately no
# default, because defaulting it would either burn the company share by sending
# it nowhere or silently hand it to the developer, and both are the kind of
# wrong that is only noticed at the end of a month.
COMPANY_PAYOUT_ADDRESS=

# The marketplace's cut in basis points. 2000 = 20%, so the developer keeps 80%.
# Read per request, so changing it needs no redeploy — and every receipt stores
# the rate it was charged at, so changing it never restates a past payout.
COMPANY_FEE_BPS=2000

# Which Algorand network settles: testnet | mainnet | localnet.
X402_NETWORK=testnet

# Optional. Defaults to the public AlgoNode endpoint for the chosen network,
# which needs no token.
ALGOD_URL=
ALGOD_TOKEN=
